<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  tools:context=".actividades.solicitud_credito.activity_solicitud_credito">

  <com.google.android.material.button.MaterialButton
    android:id="@+id/btnuevocliente"
    android:layout_width="187dp"
    android:layout_height="60dp"
    android:layout_marginStart="79dp"
    android:layout_marginTop="20dp"
    android:text="Nuevo Cliente"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/btclienteexistente"
    app:shapeAppearanceOverlay="@style/ButtomShapeArrowRight" />

  <TextView
    android:id="@+id/textView44"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="79dp"
    android:layout_marginTop="68dp"
    android:layout_marginEnd="32dp"
    android:text="Nueva Solicitud de Credito"
    android:textColor="#43A047"
    android:textSize="18sp"
    android:textStyle="bold"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintHorizontal_bias="1.0"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent" />

  <ImageView
    android:id="@+id/imageView2"
    android:layout_width="164dp"
    android:layout_height="142dp"
    android:layout_marginStart="102dp"
    android:layout_marginTop="47dp"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/textView44"
    app:srcCompat="@drawable/ic_prestamo" />

  <com.google.android.material.button.MaterialButton
    android:id="@+id/btclienteexistente"
    android:layout_width="187dp"
    android:layout_height="60dp"
    android:layout_marginStart="79dp"
    android:layout_marginTop="54dp"
    android:text="Cliente Existente"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/imageView2"
    app:shapeAppearanceOverlay="@style/ButtomShapeArrowRight" />
</androidx.constraintlayout.widget.ConstraintLayout>