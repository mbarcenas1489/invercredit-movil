<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:context=".actividades.Cuotas.fragment.FragmentTabCuotas">

    <androidx.core.widget.NestedScrollView
      android:layout_width="match_parent"
      android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
          android:layout_width="match_parent"
          android:layout_height="match_parent">

            <TextView
              android:id="@+id/tv_tab_cuotas_nombrecliente"
              android:layout_width="332dp"
              android:layout_height="19dp"
              android:layout_marginStart="8dp"
              android:layout_marginTop="4dp"
              android:text="TextView"
              android:textAlignment="center"
              android:textColor="#262626"
              android:textSize="14sp"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toTopOf="parent" />

            <TextView
              android:id="@+id/textView25"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginStart="8dp"
              android:layout_marginTop="8dp"
              android:text="Total"
              android:textColor="#64738D"
              android:textSize="12sp"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toBottomOf="@+id/tvTotal" />

            <TextView
              android:id="@+id/textView26"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:layout_marginEnd="12dp"
              android:text="Abonado"
              android:textColor="#64738D"
              android:textSize="12sp"
              app:layout_constraintEnd_toStartOf="@+id/guideline7"
              app:layout_constraintTop_toBottomOf="@+id/tvAbonado" />

            <TextView
              android:id="@+id/textView28"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginStart="8dp"
              android:layout_marginTop="4dp"
              android:text="Pendiente"
              android:textColor="#64738D"
              android:textSize="12sp"
              app:layout_constraintStart_toStartOf="@+id/guideline7"
              app:layout_constraintTop_toBottomOf="@+id/tvPendiente" />

            <TextView
              android:id="@+id/textView29"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="4dp"
              android:layout_marginEnd="8dp"
              android:text="Mora"
              android:textColor="#64738D"
              android:textSize="12sp"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintTop_toBottomOf="@+id/tvMora" />

            <TextView
              android:id="@+id/tvTotal"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginStart="8dp"
              android:layout_marginTop="8dp"
              android:text="0"
              android:textColor="#000000"
              android:textSize="18sp"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toBottomOf="@+id/tv_tab_cuotas_nombrecliente" />

            <TextView
              android:id="@+id/tvAbonado"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:layout_marginEnd="16dp"
              android:text="0"
              android:textColor="#000000"
              android:textSize="18sp"
              app:layout_constraintEnd_toStartOf="@+id/guideline7"
              app:layout_constraintTop_toBottomOf="@+id/tv_tab_cuotas_nombrecliente" />

            <TextView
              android:id="@+id/tvPendiente"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginStart="16dp"
              android:layout_marginTop="8dp"
              android:text="0"
              android:textColor="#000000"
              android:textSize="18sp"
              app:layout_constraintStart_toStartOf="@+id/guideline7"
              app:layout_constraintTop_toBottomOf="@+id/tv_tab_cuotas_nombrecliente" />

            <TextView
              android:id="@+id/tvMora"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:layout_marginEnd="8dp"
              android:text="0"
              android:textColor="#000000"
              android:textSize="18sp"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintTop_toBottomOf="@+id/tv_tab_cuotas_nombrecliente" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
              android:id="@+id/tab_cuotas_agregar_nueva"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_alignParentEnd="true"
              android:layout_alignParentRight="true"
              android:layout_alignParentBottom="true"
              android:layout_marginTop="300dp"
              android:onClick="bt_floating_addCuota"
              android:src="@drawable/ic_mas"
              android:tint="#9FE554"
              app:backgroundTint="#9FE554"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintTop_toBottomOf="@+id/tv_tab_cuotas_nombrecliente" />

            <TextView
              android:id="@+id/tvMoras"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:layout_marginEnd="9dp"
              android:text="Moras"
              android:textColor="#009688"
              android:textSize="12sp"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.Barrier
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              app:barrierDirection="left"
              tools:layout_editor_absoluteX="209dp"
              tools:layout_editor_absoluteY="94dp" />

            <androidx.constraintlayout.widget.Guideline
              android:id="@+id/guideline7"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              app:layout_constraintGuide_begin="175dp" />

            <androidx.recyclerview.widget.RecyclerView
              android:id="@+id/recyclerCuotas"
              android:layout_width="0dp"
              android:layout_height="1000dp"
              android:layout_marginStart="2dp"
              android:layout_marginTop="8dp"
              android:layout_marginEnd="2dp"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toBottomOf="@+id/textView25" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>


    <!-- TODO: Update blank fragment layout -->


</FrameLayout>