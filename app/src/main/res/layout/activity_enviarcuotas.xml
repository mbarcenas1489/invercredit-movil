<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:layout_marginBottom="@dimen/activity_horizontal_margin"
  android:paddingBottom="30dp"
  tools:context=".actividades.Activity_enviarcuotas"
  tools:layout_editor_absoluteY="25dp"
  android:id="@+id/constrain_enviocuota">

  <TextView
    android:id="@+id/textView6"
    android:layout_width="217dp"
    android:layout_height="28dp"
    android:layout_marginStart="8dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="16dp"
    android:text="Enviar Cuotas al servidor"
    android:textColor="@android:color/holo_green_dark"
    android:textSize="14sp"
    android:textStyle="bold"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintHorizontal_bias="0.274"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/iv_enviaralservidor" />

  <TextView
    android:id="@+id/textView7"
    android:layout_width="156dp"
    android:layout_height="29dp"
    android:layout_marginEnd="16dp"
    android:layout_marginStart="8dp"
    android:layout_marginTop="80dp"
    android:text="Bucar cuotas Nuevas"
    android:textColor="@android:color/holo_green_dark"
    android:textSize="14sp"
    android:textStyle="bold"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toEndOf="@+id/iv_buscarcuotas"
    app:layout_constraintTop_toTopOf="@+id/guideline" />


  <androidx.constraintlayout.widget.Guideline
    android:id="@+id/guideline"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    app:layout_constraintGuide_begin="16dp" />

  <ImageView
    android:id="@+id/iv_buscarcuotas"
    android:layout_width="139dp"
    android:layout_height="62dp"
    android:layout_marginStart="44dp"
    android:layout_marginTop="80dp"
    android:src="@drawable/ic_action_name"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="@+id/guideline" />

  <TextView
    android:id="@+id/et_num_cuotasnuevas"
    android:layout_width="155dp"
    android:layout_height="40dp"
    android:layout_marginEnd="16dp"
    android:layout_marginStart="8dp"
    android:layout_marginTop="12dp"
    android:text="0 Cuotas encontradas"
    android:textColor="@android:color/holo_blue_dark"
    android:textSize="14sp"
    android:textStyle="bold"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toEndOf="@+id/iv_buscarcuotas"
    app:layout_constraintTop_toBottomOf="@+id/textView7" />

  <ImageView
    android:id="@+id/iv_enviaralservidor"
    android:layout_width="127dp"
    android:layout_height="55dp"
    android:layout_marginTop="72dp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintHorizontal_bias="0.19"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/iv_buscarcuotas"
    app:srcCompat="@drawable/enviarservidor" />

  <TextView
    android:id="@+id/et_moras_nuevas"
    android:layout_width="153dp"
    android:layout_height="20dp"
    android:layout_marginStart="32dp"
    android:layout_marginTop="8dp"
    android:text="Numero Moras"
    android:textColor="@android:color/holo_blue_dark"
    android:textSize="14sp"
    android:textStyle="bold"
    app:layout_constraintStart_toEndOf="@+id/iv_buscarcuotas"
    app:layout_constraintTop_toBottomOf="@+id/et_num_cuotasnuevas" />

  <TextView
    android:id="@+id/et_cant_cuotas_enviadas"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="66dp"
    android:layout_marginTop="71dp"
    android:text="0 Cuotas Enviadas"
    android:textColor="#009688"
    android:textSize="18sp"
    android:textStyle="bold"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/textView6" />

  <TextView
    android:id="@+id/et_cant_moras_enviadas"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="64dp"
    android:layout_marginTop="24dp"
    android:text="0 Moras Enviadas"
    android:textColor="#009688"
    android:textSize="18sp"
    android:textStyle="bold"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/et_cant_cuotas_enviadas" />
</androidx.constraintlayout.widget.ConstraintLayout>