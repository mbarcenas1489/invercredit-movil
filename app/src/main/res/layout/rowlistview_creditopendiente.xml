<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/item_creditovencido"
  android:layout_width="match_parent"
  android:layout_height="wrap_content">

  <TextView
    android:id="@+id/tv_pos_cred_p"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="13dp"
    android:background="@drawable/textview_round"
    android:gravity="center"
    android:textColor="@android:color/white"
    android:textSize="24sp"
    android:textStyle="bold"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent" />

  <TextView
    android:id="@+id/tv_fechafin"
    android:layout_width="164dp"
    android:layout_height="19dp"
    android:layout_marginStart="12dp"
    android:layout_marginTop="2dp"
    android:text="TextView"
    app:layout_constraintStart_toEndOf="@+id/tv_pos_cred_p"
    app:layout_constraintTop_toBottomOf="@+id/tv_nombre_creP" />

  <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/constrain_vencidos"
    android:layout_width="334dp"
    android:layout_height="108dp"
    android:layout_marginStart="21dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="8dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@+id/tv_pos_cred_p">

    <TextView
      android:id="@+id/tv_setmalo"
      android:layout_width="75dp"
      android:layout_height="29dp"
      android:layout_marginStart="52dp"
      android:layout_marginTop="28dp"
      android:text="Malo"
      android:textColor="#4CAF50"
      android:textSize="18sp"
      android:textStyle="bold"
      app:layout_constraintStart_toEndOf="@+id/tv_monto_pendiente"
      app:layout_constraintTop_toTopOf="parent" />

    <TextView
      android:id="@+id/tv_monto_pendiente"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="24dp"
      android:layout_marginTop="1dp"
      android:layout_marginBottom="1dp"

      android:padding="4dp"
      android:text="TextView"
      android:textColor="#F9FAF9"
      android:textSize="16sp"
      android:textStyle="bold"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toBottomOf="@+id/textView8"
      app:layout_constraintVertical_bias="0.0" />
    <!--  android:background="@drawable/textview_round_rojo"-->

    <TextView
      android:id="@+id/textView8"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="24dp"
      android:layout_marginTop="28dp"
      android:text="Saldo"
      android:textColor="#000000"
      android:textSize="16dp"
      android:textStyle="bold"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintTop_toTopOf="parent" />

    <ImageView
      android:id="@+id/bt_detalle_credito"
      android:layout_width="39dp"
      android:layout_height="33dp"
      android:layout_marginTop="18dp"
      android:layout_marginEnd="16dp"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:srcCompat="@drawable/ic_details" />

    <TextView
      android:id="@+id/tv_nombre_creP"
      android:layout_width="0dp"
      android:layout_height="19dp"
      android:text="TextView"
      android:textColor="@android:color/holo_blue_dark"
      android:textSize="13sp"
      android:textStyle="bold"
      tools:layout_editor_absoluteX="120dp"
      tools:layout_editor_absoluteY="16dp" />
  </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>